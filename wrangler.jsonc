{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "realtree-customer-care",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "realtree-customer-care-db",
      "database_id": "e35b163c-f8be-4c4c-91e0-da276df93124"
    }
  ],
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ]
}
